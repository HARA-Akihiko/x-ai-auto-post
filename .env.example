# Copy to .env (gitignored). Generate fresh values; do not reuse example secrets.
DATABASE_URL=postgresql+psycopg://x_ai@db:5432/x_ai
POSTGRES_USER=x_ai
POSTGRES_DB=x_ai
POSTGRES_PASSWORD=
TOKEN_ENCRYPTION_KEY=
ADMIN_API_TOKEN=

# Sign in with ChatGPT runs in the local CLI (`python -m app.cli.chatgpt login`) and is
# imported here; no API key, client ID or client secret is configured.
# This server's own stable host ID, generated once:
#   python3 -c 'import uuid; print("urn:uuid:" + str(uuid.uuid4()))'
CHATGPT_HOST_ID=
# A model slug listed by `python -m app.cli.chatgpt smoke` for the connected account.
CHATGPT_MODEL=
RESPONSES_URL=https://api.openai.com/v1/responses

X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:8000/auth/x/callback
X_SCOPE=tweet.read tweet.write users.read offline.access

TIMEZONE=Asia/Tokyo
POST_TIMES=08:00,13:00,19:00
URL_POLICY=ALWAYS
CANDIDATE_LIMIT=3
ARTICLE_MAX_AGE_DAYS=7
# Opt in only after verifying the account/model permits the hosted web_search tool.
WEB_SEARCH_ENABLED=false
