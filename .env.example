# Copy to .env (gitignored). Generate fresh values; do not reuse example secrets.
DATABASE_URL=postgresql+psycopg://x_ai@db:5432/x_ai
POSTGRES_USER=x_ai
POSTGRES_DB=x_ai
POSTGRES_PASSWORD=
TOKEN_ENCRYPTION_KEY=
ADMIN_API_TOKEN=

# Use the registered client and redirect URI authorized by OpenAI for your host.
# No API key or another application's Codex client ID is used.
CHATGPT_CLIENT_ID=
CHATGPT_CLIENT_SECRET=
CHATGPT_HOST_ID=
CHATGPT_REDIRECT_URI=http://localhost:8000/auth/chatgpt/callback
CHATGPT_SCOPE=openid offline_access resource.invoke chatgpt.tokens.use.direct
CHATGPT_RESOURCE=https://api.openai.com/v1
# Set a model explicitly permitted for the connected account's plan.
CHATGPT_MODEL=
CHATGPT_AUTHORIZE_URL=https://auth.openai.com/oauth/authorize
CHATGPT_TOKEN_URL=https://auth.openai.com/oauth/token
RESPONSES_URL=https://api.openai.com/v1/responses

X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:8000/auth/x/callback
X_SCOPE=tweet.read tweet.write users.read offline.access

TIMEZONE=Asia/Tokyo
POST_TIMES=08:00,13:00,19:00
URL_POLICY=ALWAYS
CANDIDATE_LIMIT=3
ARTICLE_MAX_AGE_DAYS=7
# Opt in only after verifying the account/model permits the hosted web_search tool.
WEB_SEARCH_ENABLED=false
